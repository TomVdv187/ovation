// OVATION — canonical data model.
//
// OWNED BY THE ARCHITECT. This file is READ-ONLY for feature agents.
// Need a change? Append a request to CONTRACT_CHANGES.md at the repo root.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  LIVE
  COMPLETED
  CANCELLED
}

enum GuestSegment {
  VIP
  CLIENT
  PARTNER
  PRESS
  PROSPECT
}

enum NoShowRisk {
  LOW
  MEDIUM
  HIGH
}

enum RsvpStatus {
  INVITED
  CONFIRMED
  DECLINED
  WAITLISTED
  CHECKED_IN
  NO_SHOW
}

enum TicketTierStatus {
  DRAFT
  ON_SALE
  SOLD_OUT
  CLOSED
}

enum OrderStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
  CANCELLED
}

enum SponsorPackage {
  GOLD
  SILVER
  CUSTOM
}

enum SponsorStatus {
  PROSPECT
  OFFERED
  SIGNED
  SERVICED
}

enum EmailStatus {
  PROPOSED
  APPROVED
  QUEUED
  SENT
  FAILED
  REJECTED
}

enum EmailKind {
  INVITE
  REMINDER
  CONFIRMATION
  RECOVERY
  SPONSOR_REPORT
  SPONSOR_OFFER
  ANNOUNCEMENT
  OTHER
}

/// Lifecycle of an agent-proposed action. Nothing the agent decides reaches the
/// outside world without passing APPROVED -> EXECUTED.
enum AgentActionStatus {
  PROPOSED
  APPROVED
  EXECUTED
  REJECTED
  FAILED
}

enum ActorKind {
  AGENT
  USER
  SYSTEM
}

/// How much scrutiny an action needs before it executes.
/// COSMETIC may be auto-approved per-org; OUTBOUND and DESTRUCTIVE never are.
enum ActionRisk {
  COSMETIC
  OPERATIONAL
  OUTBOUND
  DESTRUCTIVE
}

enum CostCategory {
  VENUE
  CATERING
  PRODUCTION
  STAFF
  MARKETING
  TRAVEL
  OTHER
}

enum ChatRole {
  USER
  ASSISTANT
  TOOL
}

// ─────────────────────────────────────────────────────────────
// Tenancy & auth
// ─────────────────────────────────────────────────────────────

model Organisation {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  /// { autoApproveCosmetic: bool, defaultCurrency: string, locale: string, brand: {...} }
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  events       Event[]
  agentActions AgentAction[]

  @@index([slug])
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  role           UserRole  @default(MEMBER)
  organisationId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  accounts     Account[]
  sessions     Session[]

  @@index([organisationId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────
// The event
// ─────────────────────────────────────────────────────────────

model Event {
  id             String      @id @default(cuid())
  organisationId String
  title          String
  slug           String      @unique
  description    String?
  date           DateTime
  endsAt         DateTime?
  timezone       String      @default("Europe/Brussels")
  venue          String
  venueAddress   String?
  capacity       Int
  currency       String      @default("EUR")
  status         EventStatus @default(DRAFT)

  /// EventTheme — see packages/core/src/schemas/event.ts (themeSchema).
  /// { preset: "classic" | "blacktie", palette: {...}, typography: {...}, dressCode?, heroImage? }
  theme Json @default("{}")

  /// Agenda — { items: [{ id, startsAt, endsAt?, title, speaker?, room?, kind }] }
  agenda Json @default("{}")

  /// Registration form config — { fields: [...], collectDietary, allowPlusOnes, maxPlusOnes, consentText }
  registrationConfig Json @default("{}")

  // Public-page analytics (written by apps/events, read by packages/revenue)
  pageVisits       Int @default(0)
  rsvpConversions  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation  Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  guests        Guest[]
  ticketTiers   TicketTier[]
  orders        Order[]
  sponsors      Sponsor[]
  emails        EmailMessage[]
  checkIns      CheckIn[]
  introductions Introduction[]
  cues          Cue[]
  announcements Announcement[]
  agentActions  AgentAction[]
  costs         CostEntry[]
  chatMessages  ChatMessage[]

  @@index([organisationId])
  @@index([slug])
  @@index([status, date])
}

// ─────────────────────────────────────────────────────────────
// Guests
// ─────────────────────────────────────────────────────────────

model Guest {
  id      String @id @default(cuid())
  eventId String

  name    String
  email   String
  company String?
  title   String?

  segment    GuestSegment @default(PROSPECT)
  rsvpStatus RsvpStatus   @default(INVITED)

  /// 0–100, deterministic. See packages/guests.
  engagementScore Int @default(0)
  /// Explainability: [{ factor, weight, detail }] — top-3 drivers of the score.
  engagementFactors Json @default("[]")

  noShowRisk        NoShowRisk @default(LOW)
  noShowProbability Float?
  /// Recommended recovery action: { action, reason, dueBy? }
  recoveryAction Json?

  dietary   String?
  plusOnes  Int      @default(0)
  interests String[] @default([])
  notes     String?

  /// VIP white-glove checklist — { transport, seating, dietary, host, done: [...] }
  whiteGlove Json?

  /// Where the guest came from: "seed" | "registration" | "import" | "waitlist"
  source String @default("import")

  // Behavioural counters (fed by apps/events + email tracking)
  emailOpens   Int       @default(0)
  emailClicks  Int       @default(0)
  pageVisits   Int       @default(0)
  lastSeenAt   DateTime?
  registeredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event    Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  emails   EmailMessage[]
  checkIn  CheckIn?
  orders   Order[]

  @@unique([eventId, email])
  @@index([eventId, segment])
  @@index([eventId, rsvpStatus])
  @@index([eventId, noShowRisk])
}

// ─────────────────────────────────────────────────────────────
// Ticketing
// ─────────────────────────────────────────────────────────────

model TicketTier {
  id      String @id @default(cuid())
  eventId String

  name        String
  description String?
  /// Minor units (cents). 0 = free tier.
  priceCents Int
  currency   String           @default("EUR")
  quota      Int
  sold       Int              @default(0)
  status     TicketTierStatus @default(DRAFT)
  sortOrder  Int              @default(0)

  /// Dynamic pricing rule — see autoOpenRuleSchema in packages/core/src/schemas/revenue.ts.
  /// { when: { type: "TIER_SOLD_OUT", tierName } | { type: "DATE", at } | { type: "PERCENT_SOLD", tierName, percent },
  ///   then: { openTier: { name, priceCents, quota } } }
  autoOpenRule Json?

  opensAt  DateTime?
  closesAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event  Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([eventId, name])
  @@index([eventId, status])
}

model Order {
  id      String @id @default(cuid())
  eventId String
  tierId  String
  guestId String?

  email String
  /// CC-002. The name typed at checkout. A ticket buyer is not a Guest until
  /// the payment settles, so between startCheckout and fulfilOrder this is the
  /// only place the name exists.
  buyerName   String?
  quantity    Int         @default(1)
  amountCents Int
  currency    String      @default("EUR")
  status      OrderStatus @default(PENDING)

  stripeSessionId       String? @unique
  stripePaymentIntentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tier  TicketTier @relation(fields: [tierId], references: [id], onDelete: Restrict)
  guest Guest?     @relation(fields: [guestId], references: [id], onDelete: SetNull)

  @@index([eventId, status])
  @@index([tierId])
  @@index([guestId])
}

// ─────────────────────────────────────────────────────────────
// Revenue
// ─────────────────────────────────────────────────────────────

model Sponsor {
  id      String @id @default(cuid())
  eventId String

  name         String
  package      SponsorPackage @default(CUSTOM)
  amountCents  Int
  currency     String         @default("EUR")
  status       SponsorStatus  @default(PROSPECT)
  contactName  String?
  contactEmail String?
  logoUrl      String?

  /// Entitlements — { logoPlacements: [...], vipDinnerSeats, targetAccountIntros, standSize? }
  entitlements Json @default("{}")
  /// Company names this sponsor wants to meet — joined against Guest.company.
  targetAccounts String[] @default([])
  /// ROI snapshot — { logoImpressions, leads, meetings, reportOpens, renewalIntent }
  roiStats Json @default("{}")

  /// 0–100 engagement with our reporting — drives the Gold-upgrade upsell radar.
  engagementScore Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event  Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  emails EmailMessage[]

  @@unique([eventId, name])
  @@index([eventId, status])
}

/// Committed costs — the other half of the margin calculation.
model CostEntry {
  id      String @id @default(cuid())
  eventId String

  label       String
  category    CostCategory @default(OTHER)
  amountCents Int
  currency    String       @default("EUR")
  committed   Boolean      @default(true)
  vendor      String?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, category])
}

// ─────────────────────────────────────────────────────────────
// Communication
// ─────────────────────────────────────────────────────────────

model EmailMessage {
  id        String  @id @default(cuid())
  eventId   String
  guestId   String?
  sponsorId String?

  kind        EmailKind   @default(OTHER)
  subject     String
  body        String      @db.Text
  /// True when written per-recipient by the LLM (not a merge-field template).
  personalised Boolean    @default(false)
  status      EmailStatus @default(PROPOSED)

  /// Campaign grouping so approval can act on a batch.
  campaignId String?

  providerMessageId String?
  sentAt            DateTime?
  openedAt          DateTime?
  clickedAt         DateTime?
  error             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest   Guest?   @relation(fields: [guestId], references: [id], onDelete: Cascade)
  sponsor Sponsor? @relation(fields: [sponsorId], references: [id], onDelete: Cascade)

  @@index([eventId, status])
  @@index([campaignId])
  @@index([guestId])
}

model Announcement {
  id      String @id @default(cuid())
  eventId String

  title    String?
  body     String   @db.Text
  /// Where it was pushed: ["guest-app", "host", "screens"]
  channels String[] @default([])

  deliveredCount Int @default(0)
  createdBy      String?

  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Live ops
// ─────────────────────────────────────────────────────────────

model CheckIn {
  id      String @id @default(cuid())
  eventId String
  guestId String @unique

  timestamp DateTime @default(now())
  lane      String   @default("main")
  deviceId  String?
  /// True when the scan happened offline and was replayed from the sync queue.
  offlineSynced Boolean @default(false)
  /// CC-006. The scan's idempotency key, so replaying an offline queue is safe
  /// across a restart and across app instances — guestId @unique dedupes by
  /// GUEST, which is a different guarantee.
  idempotencyKey String?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@unique([eventId, idempotencyKey])
  @@index([eventId, timestamp])
  @@index([eventId, lane])
}

/// CC-007. A host marking two guests as introduced. Survives a phone reload,
/// and stops a second host being offered an introduction the first already made.
model Introduction {
  id          String @id @default(cuid())
  eventId     String
  guestId     String
  withGuestId String

  /// User id of the host who marked it, when known.
  introducedBy String?
  createdAt    DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, guestId, withGuestId])
  @@index([eventId])
}

/// CC-008. Per-event cue configuration, mirroring cueSchema in
/// packages/core/src/schemas/live.ts. An organiser who disables the capacity
/// cue at 19:00 keeps it disabled across a deploy.
model Cue {
  id      String  @id @default(cuid())
  eventId String
  label   String
  /// CueTrigger — { kind, ... }. See cueTriggerSchema.
  trigger Json
  auto    Boolean @default(false)
  enabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

// ─────────────────────────────────────────────────────────────
// The agent
// ─────────────────────────────────────────────────────────────

/// Every side effect the agent wants to have passes through this table.
/// PROPOSED -> (approve) -> APPROVED -> (execute) -> EXECUTED.
/// Nothing may mutate the world straight from a tool call.
model AgentAction {
  id             String @id @default(cuid())
  organisationId String
  eventId        String?

  /// Tool name, 1:1 with the agent tool registry: "update_event_theme", "draft_emails", ...
  type String
  /// One-line human summary rendered on the proposal card.
  summary String
  /// Tool input + everything execution needs. Shape per type — see agentActionPayloadSchema.
  payload Json @default("{}")
  /// What the organiser is agreeing to: side effects the agent predicts.
  sideEffects Json @default("[]")

  status AgentActionStatus @default(PROPOSED)
  risk   ActionRisk        @default(OPERATIONAL)

  createdBy   ActorKind @default(AGENT)
  createdById String?
  approvedBy  String?
  approvedAt  DateTime?
  executedAt  DateTime?
  /// Execution result, for the activity feed and undo.
  result Json?
  error  String?

  /// Links the proposal back to the chat turn that produced it.
  chatMessageId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  event        Event?       @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, status])
  @@index([organisationId, createdAt])
  @@index([type])
}

/// Persisted agent conversation, so the console chat survives a reload.
model ChatMessage {
  id      String @id @default(cuid())
  eventId String

  role    ChatRole
  content String   @db.Text
  /// Raw tool_use / tool_result blocks from the Anthropic turn.
  toolCalls Json?
  /// Suggestion chips rendered under the reply.
  suggestions String[] @default([])

  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
}
