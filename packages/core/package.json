{
  "name": "@ovation/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./db": "./src/db.ts",
    "./env": "./src/env.ts",
    "./schemas": "./src/schemas/index.ts",
    "./trpc": "./src/trpc/index.ts",
    "./design/tokens.css": "./src/design/tokens.css",
    "./design/tokens": "./src/design/tokens.ts",
    "./tailwind-preset": "./src/design/tailwind-preset.ts"
  },
  "scripts": {
    "build": "prisma generate",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "dotenv -e ../../.env -- tsx prisma/push.ts",
    "db:push:tcp": "dotenv -e ../../.env -- prisma db push",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "db:bootstrap": "dotenv -e ../../.env -- tsx prisma/bootstrap.ts",
    "db:provision:prod": "dotenv -e ../../.env -- tsx prisma/provision-prod.ts",
    "db:push:prod": "dotenv -e ../../.env.production -- tsx prisma/push.ts",
    "db:bootstrap:prod": "dotenv -e ../../.env.production -- tsx prisma/bootstrap.ts",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "db:reset": "dotenv -e ../../.env -- tsx prisma/push.ts --force && pnpm db:seed",
    "clean": "rimraf .turbo node_modules/.prisma *.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "@prisma/adapter-neon": "^6.19.3",
    "@prisma/client": "^6.2.1",
    "@trpc/server": "^11.0.0",
    "superjson": "^2.2.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prisma": "^6.2.1",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
