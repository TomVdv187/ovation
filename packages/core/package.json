{
  "name": "@ovation/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./db": "./src/db.ts",
    "./env": "./src/env.ts",
    "./schemas": "./src/schemas/index.ts",
    "./trpc": "./src/trpc/index.ts",
    "./design/tokens.css": "./src/design/tokens.css",
    "./design/tokens": "./src/design/tokens.ts",
    "./tailwind-preset": "./src/design/tailwind-preset.ts"
  },
  "scripts": {
    "build": "prisma generate",
    "typecheck": "prisma generate && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma db push --force-reset && pnpm db:seed",
    "clean": "rimraf .turbo node_modules/.prisma *.tsbuildinfo"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "@trpc/server": "^11.0.0",
    "superjson": "^2.2.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prisma": "^6.2.1",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
