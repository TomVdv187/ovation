{
  "name": "ovation",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @ovation/core db:generate",
    "db:push": "pnpm --filter @ovation/core db:push",
    "db:push:tcp": "pnpm --filter @ovation/core db:push:tcp",
    "db:seed": "pnpm --filter @ovation/core db:seed",
    "db:studio": "pnpm --filter @ovation/core db:studio",
    "db:reset": "pnpm --filter @ovation/core db:reset",
    "clean": "turbo run clean && rimraf node_modules",
    "critic": "tsx --env-file=.env"
  },
  "devDependencies": {
    "@ovation/core": "workspace:*",
    "@ovation/guests": "workspace:*",
    "@ovation/revenue": "workspace:*",
    "@types/node": "^22.10.2",
    "dotenv-cli": "^8.0.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp"
    ]
  }
}
