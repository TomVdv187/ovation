    "typescript": "^5.7.2",
    "@ovation/guests": "workspace:*",
    "@ovation/revenue": "workspace:*",
    "@ovation/events": "workspace:*",
    "@ovation/live": "workspace:*",
    "dotenv-cli": "^8.0.0"
  }
