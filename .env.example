# ─────────────────────────────────────────────────────────────
# OVATION — copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────────────────────────

# Postgres (Neon / Supabase / Railway / local). Pooled connection.
# This is the ONLY .env in the repo — scripts load it via dotenv-cli, because
# neither Prisma nor Next.js looks outside its own package for one.
DATABASE_URL="postgresql://user:password@host:5432/ovation?sslmode=require"
# Direct (non-pooled) connection — used by prisma migrate/db push on Neon &
# Supabase. If your provider has no pooler, set it to the same value as above.
# Neon via Vercel exports this as DATABASE_URL_UNPOOLED; copy that value here.
DIRECT_URL="postgresql://user:password@host:5432/ovation?sslmode=require"

# Auth (NextAuth v5). Generate a secret with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Email — Resend (magic links + transactional). Leave blank in dev to log to console.
RESEND_API_KEY=""
EMAIL_FROM="OVATION <hello@ovation.local>"

# Anthropic — the agent brain
ANTHROPIC_API_KEY=""

# Stripe — ticketing
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Realtime (Pusher-protocol compatible: Pusher SaaS or self-hosted Soketi)
REALTIME_APP_ID=""
REALTIME_KEY=""
REALTIME_SECRET=""
REALTIME_CLUSTER="eu"
NEXT_PUBLIC_REALTIME_KEY=""
NEXT_PUBLIC_REALTIME_CLUSTER="eu"

# Check-in QR token signing (JWT). openssl rand -base64 32
QR_SIGNING_SECRET=""

# Public URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_EVENTS_URL="http://localhost:3001"
